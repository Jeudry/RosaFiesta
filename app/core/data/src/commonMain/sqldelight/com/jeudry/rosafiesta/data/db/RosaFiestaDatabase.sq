CREATE TABLE IF NOT EXISTS LocalArticleEntity (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    description TEXT NOT NULL,
    pricePerDayDop INTEGER NOT NULL,
    totalStock INTEGER NOT NULL,
    availableOct23 INTEGER NOT NULL,
    photoKey TEXT NOT NULL,
    photoUrl TEXT NOT NULL DEFAULT '',
    damagedStock INTEGER NOT NULL DEFAULT 0,
    variantsJson TEXT NOT NULL DEFAULT '[]',
    dimensions TEXT NOT NULL DEFAULT '',
    material TEXT NOT NULL DEFAULT '',
    visibleInCatalog INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS LocalChecklistStepEntity (
    id TEXT NOT NULL PRIMARY KEY,
    stageLabel TEXT NOT NULL,
    title TEXT NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    completedBy TEXT NOT NULL,
    timeLabel TEXT NOT NULL,
    eventId TEXT NOT NULL DEFAULT 'evt-boda-real'
);

CREATE TABLE IF NOT EXISTS LocalOfflineMutationEntity (
    id TEXT NOT NULL PRIMARY KEY,
    actionLabel TEXT NOT NULL,
    entityCode TEXT NOT NULL,
    timeAgo TEXT NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0,
    operationType TEXT NOT NULL DEFAULT '',
    payloadJson TEXT NOT NULL DEFAULT '{}',
    idempotencyKey TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS eventEntity (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    title TEXT NOT NULL,
    clientName TEXT NOT NULL,
    eventType TEXT NOT NULL,
    dateLabel TEXT NOT NULL,
    daysUntilEvent INTEGER NOT NULL,
    venue TEXT NOT NULL,
    zone TEXT NOT NULL,
    guests INTEGER NOT NULL,
    articleCount INTEGER NOT NULL,
    totalDop INTEGER NOT NULL,
    paidDepositDop INTEGER NOT NULL,
    depositMethodLabel TEXT NOT NULL,
    depositDateLabel TEXT NOT NULL,
    balanceDueDateLabel TEXT NOT NULL,
    status TEXT NOT NULL,
    leadStaffName TEXT NOT NULL,
    photoKey TEXT NOT NULL,
    priorChangesCount INTEGER NOT NULL DEFAULT 0,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    eventDateIso TEXT NOT NULL DEFAULT '',
    pickupDateIso TEXT NOT NULL DEFAULT '',
    returnDateIso TEXT NOT NULL DEFAULT '',
    quoteId TEXT NOT NULL DEFAULT '',
    closeoutCompleted INTEGER NOT NULL DEFAULT 0,
    closeoutNotes TEXT NOT NULL DEFAULT '',
    sketchJson TEXT NOT NULL DEFAULT '',
    lastPaymentReminderAt TEXT NOT NULL DEFAULT '',
    lastPaymentReminderChannel TEXT NOT NULL DEFAULT '',
    itemsJson TEXT NOT NULL DEFAULT '[]',
    clientEmail TEXT NOT NULL DEFAULT '',
    cancellationReason TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS paymentEntity (
    id TEXT NOT NULL PRIMARY KEY,
    receiptNumber TEXT NOT NULL,
    eventId TEXT NOT NULL,
    eventTitle TEXT NOT NULL,
    clientName TEXT NOT NULL,
    amountDop INTEGER NOT NULL,
    methodLabel TEXT NOT NULL,
    kindLabel TEXT NOT NULL,
    dateLabel TEXT NOT NULL,
    referenceCode TEXT NOT NULL,
    verified INTEGER NOT NULL DEFAULT 1,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    voucherUrl TEXT NOT NULL DEFAULT '',
    ncfType TEXT NOT NULL DEFAULT 'B02',
    ncfNumber TEXT NOT NULL DEFAULT '',
    clientRnc TEXT NOT NULL DEFAULT '',
    subtotalDop INTEGER NOT NULL DEFAULT 0,
    itbisDop INTEGER NOT NULL DEFAULT 0,
    securityDepositDop INTEGER NOT NULL DEFAULT 0,
    rejectionReason TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS quoteEntity (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL,
    eventId TEXT NOT NULL,
    eventTitle TEXT NOT NULL,
    clientName TEXT NOT NULL,
    clientEmail TEXT NOT NULL,
    venue TEXT NOT NULL,
    dateLabel TEXT NOT NULL,
    guests INTEGER NOT NULL,
    status TEXT NOT NULL,
    linesJson TEXT NOT NULL DEFAULT '[]',
    deliveryFeeDop INTEGER NOT NULL,
    discountDop INTEGER NOT NULL,
    totalDop INTEGER NOT NULL,
    signatureSvg TEXT NOT NULL,
    depositPercent INTEGER NOT NULL,
    depositDop INTEGER NOT NULL,
    signedByName TEXT NOT NULL,
    rejectionReason TEXT NOT NULL,
    eventDateIso TEXT NOT NULL,
    packageId TEXT NOT NULL,
    contractPdfUrl TEXT NOT NULL,
    signedAtIso TEXT NOT NULL,
    sortOrder INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS deliveryStopEntity (
    stopOrder INTEGER NOT NULL,
    eventId TEXT NOT NULL,
    eventTitle TEXT NOT NULL,
    venue TEXT NOT NULL,
    windowLabel TEXT NOT NULL,
    vehicleAndCrew TEXT NOT NULL,
    statusLabel TEXT NOT NULL,
    PRIMARY KEY(eventId, windowLabel)
);

CREATE TABLE IF NOT EXISTS damageIncidentEntity (
    id TEXT NOT NULL PRIMARY KEY,
    eventId TEXT NOT NULL,
    eventTitle TEXT NOT NULL,
    articleCode TEXT NOT NULL,
    articleName TEXT NOT NULL,
    damagedUnits INTEGER NOT NULL,
    missingUnits INTEGER NOT NULL,
    replacementDop INTEGER NOT NULL,
    notes TEXT NOT NULL,
    photoUrl TEXT NOT NULL,
    resolutionNotes TEXT NOT NULL,
    chargePaymentId TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS notificationEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    category TEXT NOT NULL,
    createdAtLabel TEXT NOT NULL,
    isRead INTEGER NOT NULL DEFAULT 0,
    recipientRole TEXT NOT NULL,
    actionPath TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS favoriteEntity (
    articleId TEXT NOT NULL PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS staffPermissionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    roleLabel TEXT NOT NULL,
    role TEXT NOT NULL,
    activeEventsCount INTEGER NOT NULL,
    permissionsCsv TEXT NOT NULL,
    canViewPayments INTEGER NOT NULL DEFAULT 1,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    email TEXT NOT NULL DEFAULT '',
    phone TEXT NOT NULL DEFAULT '',
    active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS submoduleSnapshotEntity (
    snapshotKey TEXT NOT NULL PRIMARY KEY,
    payloadJson TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS chatMessageEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    formattedMessage TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS userAccountEntity (
    id TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    email TEXT NOT NULL,
    fullName TEXT NOT NULL,
    passwordHash TEXT NOT NULL,
    salt TEXT NOT NULL,
    birthDate TEXT NOT NULL DEFAULT '',
    phone TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT 'client',
    pushNotificationsEnabled INTEGER NOT NULL DEFAULT 1,
    whatsappAlertsEnabled INTEGER NOT NULL DEFAULT 1,
    emailReceiptsEnabled INTEGER NOT NULL DEFAULT 1,
    biometricLockEnabled INTEGER NOT NULL DEFAULT 0,
    autoSyncWifiOnly INTEGER NOT NULL DEFAULT 0,
    eventRemindersEnabled INTEGER NOT NULL DEFAULT 1,
    preferredLanguage TEXT NOT NULL DEFAULT 'es',
    darkThemeEnabled INTEGER NOT NULL DEFAULT 0,
    savedPaymentMethod TEXT NOT NULL DEFAULT 'Transferencia',
    profileZone TEXT NOT NULL DEFAULT 'Distrito Nacional'
);

CREATE TABLE IF NOT EXISTS activeSessionEntity (
    slot INTEGER NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    accessToken TEXT NOT NULL
);

selectAllArticles:
SELECT * FROM LocalArticleEntity ORDER BY code ASC;

upsertArticle:
INSERT OR REPLACE INTO LocalArticleEntity(
    id, code, name, category, description, pricePerDayDop, totalStock, availableOct23,
    photoKey, photoUrl, damagedStock, variantsJson, dimensions, material, visibleInCatalog
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateArticleStock:
UPDATE LocalArticleEntity
SET totalStock = ?, availableOct23 = ?
WHERE id = ?;

deleteArticleById:
DELETE FROM LocalArticleEntity
WHERE id = ?;

deleteAllArticles:
DELETE FROM LocalArticleEntity;

selectAllChecklistSteps:
SELECT * FROM LocalChecklistStepEntity ORDER BY id ASC;

upsertChecklistStep:
INSERT OR REPLACE INTO LocalChecklistStepEntity(id, stageLabel, title, completed, completedBy, timeLabel, eventId)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateChecklistStepStatus:
UPDATE LocalChecklistStepEntity
SET completed = ?, timeLabel = ?
WHERE id = ?;

deleteAllChecklistSteps:
DELETE FROM LocalChecklistStepEntity;

selectAllOfflineMutations:
SELECT * FROM LocalOfflineMutationEntity ORDER BY id ASC;

selectPendingOfflineMutations:
SELECT * FROM LocalOfflineMutationEntity WHERE synced = 0 ORDER BY id ASC;

upsertOfflineMutation:
INSERT OR REPLACE INTO LocalOfflineMutationEntity(
    id, actionLabel, entityCode, timeAgo, synced, operationType, payloadJson, idempotencyKey
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

markAllOfflineMutationsSynced:
UPDATE LocalOfflineMutationEntity SET synced = 1;

markOfflineMutationSyncedById:
UPDATE LocalOfflineMutationEntity SET synced = 1 WHERE id = ?;

deleteAllOfflineMutations:
DELETE FROM LocalOfflineMutationEntity;

selectAllEvents:
SELECT * FROM eventEntity ORDER BY sortOrder ASC, id ASC;

upsertEvent:
INSERT OR REPLACE INTO eventEntity(
    id, code, title, clientName, eventType, dateLabel, daysUntilEvent, venue, zone,
    guests, articleCount, totalDop, paidDepositDop, depositMethodLabel, depositDateLabel,
    balanceDueDateLabel, status, leadStaffName, photoKey, priorChangesCount, sortOrder,
    eventDateIso, pickupDateIso, returnDateIso, quoteId, closeoutCompleted, closeoutNotes, sketchJson,
    lastPaymentReminderAt, lastPaymentReminderChannel, itemsJson, clientEmail, cancellationReason
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateEventDateAndTotal:
UPDATE eventEntity
SET dateLabel = ?, totalDop = ?, priorChangesCount = ?
WHERE id = ?;

updateEventStatus:
UPDATE eventEntity
SET status = ?, cancellationReason = ?
WHERE id = ?;

updateEventPaidDeposit:
UPDATE eventEntity
SET paidDepositDop = ?, depositMethodLabel = ?
WHERE id = ?;

deleteEventById:
DELETE FROM eventEntity
WHERE id = ?;

deleteAllEvents:
DELETE FROM eventEntity;

selectAllPayments:
SELECT * FROM paymentEntity ORDER BY sortOrder ASC, id ASC;

upsertPayment:
INSERT OR REPLACE INTO paymentEntity(
    id, receiptNumber, eventId, eventTitle, clientName, amountDop,
    methodLabel, kindLabel, dateLabel, referenceCode, verified, sortOrder,
    voucherUrl, ncfType, ncfNumber, clientRnc, subtotalDop, itbisDop, securityDepositDop, rejectionReason
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllPayments:
DELETE FROM paymentEntity;

selectAllQuotes:
SELECT * FROM quoteEntity ORDER BY sortOrder ASC, id ASC;

upsertQuote:
INSERT OR REPLACE INTO quoteEntity(
    id, code, eventId, eventTitle, clientName, clientEmail, venue, dateLabel,
    guests, status, linesJson, deliveryFeeDop, discountDop, totalDop, signatureSvg,
    depositPercent, depositDop, signedByName, rejectionReason, eventDateIso, packageId,
    contractPdfUrl, signedAtIso, sortOrder
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllQuotes:
DELETE FROM quoteEntity;

selectAllDeliveryStops:
SELECT * FROM deliveryStopEntity ORDER BY stopOrder ASC, eventId ASC;

clearDeliveryStops:
DELETE FROM deliveryStopEntity;

upsertDeliveryStop:
INSERT OR REPLACE INTO deliveryStopEntity(
    stopOrder, eventId, eventTitle, venue, windowLabel, vehicleAndCrew, statusLabel
)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllDamageIncidents:
SELECT * FROM damageIncidentEntity ORDER BY id ASC;

upsertDamageIncident:
INSERT OR REPLACE INTO damageIncidentEntity(
    id, eventId, eventTitle, articleCode, articleName, damagedUnits, missingUnits,
    replacementDop, notes, photoUrl, resolutionNotes, chargePaymentId
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllDamageIncidents:
DELETE FROM damageIncidentEntity;

selectAllNotifications:
SELECT * FROM notificationEntity ORDER BY id ASC;

upsertNotification:
INSERT OR REPLACE INTO notificationEntity(
    id, title, body, category, createdAtLabel, isRead, recipientRole, actionPath
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteAllNotifications:
DELETE FROM notificationEntity;

selectAllFavorites:
SELECT articleId FROM favoriteEntity ORDER BY articleId ASC;

insertFavorite:
INSERT OR REPLACE INTO favoriteEntity(articleId) VALUES (?);

deleteFavorite:
DELETE FROM favoriteEntity WHERE articleId = ?;

deleteAllFavorites:
DELETE FROM favoriteEntity;

selectAllStaffPermissions:
SELECT * FROM staffPermissionEntity ORDER BY sortOrder ASC;

upsertStaffPermission:
INSERT OR REPLACE INTO staffPermissionEntity(
    id, name, roleLabel, role, activeEventsCount, permissionsCsv, canViewPayments, sortOrder, email, phone, active
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStaffPaymentAccess:
UPDATE staffPermissionEntity
SET canViewPayments = ?, permissionsCsv = ?, roleLabel = ?
WHERE name = ?;

clearStaffPermissions:
DELETE FROM staffPermissionEntity;

selectAllSubmoduleSnapshots:
SELECT snapshotKey, payloadJson FROM submoduleSnapshotEntity ORDER BY snapshotKey ASC;

upsertSubmoduleSnapshot:
INSERT OR REPLACE INTO submoduleSnapshotEntity(snapshotKey, payloadJson)
VALUES (?, ?);

deleteAllSubmoduleSnapshots:
DELETE FROM submoduleSnapshotEntity;

selectAllChatMessages:
SELECT formattedMessage FROM chatMessageEntity ORDER BY id ASC;

insertChatMessage:
INSERT INTO chatMessageEntity(formattedMessage) VALUES (?);

deleteAllChatMessages:
DELETE FROM chatMessageEntity;

selectAllUserAccounts:
SELECT * FROM userAccountEntity ORDER BY id ASC;

upsertUserAccount:
INSERT OR REPLACE INTO userAccountEntity(
    id, username, email, fullName, passwordHash, salt, birthDate, phone, role,
    pushNotificationsEnabled, whatsappAlertsEnabled, emailReceiptsEnabled, biometricLockEnabled, autoSyncWifiOnly,
    eventRemindersEnabled, preferredLanguage, darkThemeEnabled, savedPaymentMethod, profileZone
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateUserAccountPassword:
UPDATE userAccountEntity
SET passwordHash = ?, salt = ?
WHERE id = ?;

deleteUserAccountById:
DELETE FROM userAccountEntity WHERE id = ?;

selectActiveSession:
SELECT userId, accessToken FROM activeSessionEntity WHERE slot = 1;

upsertActiveSession:
INSERT OR REPLACE INTO activeSessionEntity(slot, userId, accessToken)
VALUES (1, ?, ?);

clearActiveSession:
DELETE FROM activeSessionEntity WHERE slot = 1;
