<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform lo exige: sin esto las pantallas de 120 Hz se ven a tirones. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Permite hablar con el servidor local (localhost) por http en desarrollo; el resto exige https. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jeudry.rosafiesta.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rosafiesta</string>
			</array>
		</dict>
	</array>
	<key>RosaFiestaApiUrl</key>
	<string></string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
