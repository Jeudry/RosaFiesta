PORT=8788
ENV=development
ROSAFIESTA_SEED_MODE=admin_only
DATABASE_URL=postgres://rosafiesta:rosafiesta_dev@localhost:5433/rosafiesta?sslmode=disable
TEST_DATABASE_URL=postgres://rosafiesta:rosafiesta_test@localhost:55433/rosafiesta_test?sslmode=disable
PUBLIC_APP_BASE_URL=http://localhost:8788
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_DIR=./var/media
MEDIA_MAX_BYTES=10485760
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# IA & Transcripción por voz (gemini | groq | openai)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
AI_PROVIDER_API_KEY=
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash-lite
STT_API_URL=
STT_API_KEY=

# Correo SMTP externo (sin servidor SMTP falso)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@rosafiesta.do
SMTP_USERNAME=
SMTP_PASSWORD=
ALLOW_SIMULATED_OTP=false

# Proveedores externos opcionales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FCM_SERVER_URL=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.jeudry.rosafiesta
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=false
WEB_PUSH_VAPID_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:hola@rosafiesta.do
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ADMIN_DOMAIN=admin.rosafiesta.do
