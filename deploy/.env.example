# Copia este archivo a deploy/.env y rellénalo. NO subas deploy/.env al repositorio.
API_DOMAIN=api.rosafiesta.do
WEB_DOMAIN=app.rosafiesta.do
ADMIN_DOMAIN=admin.rosafiesta.do
API_TAG=latest
PUBLIC_APP_BASE_URL=https://app.rosafiesta.do
ROSAFIESTA_SEED_MODE=admin_only
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32

# Primer administrador en producción (idempotente cuando no existe admin en DB)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

POSTGRES_USER=rosafiesta
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga-y-segura
POSTGRES_DB=rosafiesta_prod
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-64-caracteres-en-produccion

CORS_ALLOWED_ORIGINS=https://app.rosafiesta.do,https://admin.rosafiesta.do
WEB_DIST_DIR=../app/composeApp/build/dist/wasmJs/productionExecutable

MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_BYTES=16777216
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
AI_PROVIDER_API_KEY=
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash-lite
STT_API_URL=
STT_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@rosafiesta.do
SMTP_USERNAME=
SMTP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

FCM_SERVER_URL=
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.jeudry.rosafiesta
APNS_PRIVATE_KEY=
