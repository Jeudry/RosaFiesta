# HTTPS automático (Let's Encrypt) para API y frontends Web WasmJS de RosaFiesta.
{$API_DOMAIN} {
	@sse path /v1/stream
	handle @sse {
		reverse_proxy api:8788 {
			flush_interval -1
			header_up X-Accel-Buffering no
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy api:8788
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
	log {
		output stdout
		format json
	}
}

{$WEB_DOMAIN}, {$ADMIN_DOMAIN:admin.rosafiesta.do} {
	encode zstd gzip
	root * /srv/web

	@service_worker path /sw.js
	header @service_worker {
		Cache-Control "no-cache"
		Service-Worker-Allowed "/"
	}

	@wasm_assets {
		path *.wasm *.js
		not path /sw.js
	}
	header @wasm_assets {
		Cache-Control "public, max-age=3600"
	}

	try_files {path} /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://{$API_DOMAIN}; font-src 'self' data:; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:"
		-Server
	}
	log {
		output stdout
		format json
	}
}
